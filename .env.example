# Interledger Open Payments Test Wallet Credentials
INTERLEDGER_WALLET_ADDRESS=https://ilp.interledger-test.dev/qpay
INTERLEDGER_KEY_ID=your-interledger-key-id
INTERLEDGER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_ED25519_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Conversion rate from Qpay display currency (NGN) to USD wallet asset minor units
INTERLEDGER_NGN_TO_USD_RATE=1600

# Optional standalone backend server port (dev server proxies/mounts /api/interledger automatically)
INTERLEDGER_SERVER_PORT=3001
